generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  BOTH
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  role          Role      @default(CUSTOMER)
  adminRole     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]

  @@map("users")
}

// ─── Bookings ────────────────────────────────────────────────────────────────

enum BookingStatus {
  DEPOSIT_ONLY
  PARTIALLY_PAID
  FULLY_PAID
  FAILED
  CANCELLED
}

enum PaymentPlan {
  FULL
  INSTALMENT
}

model Booking {
  id           String        @id @default(cuid())
  ref          String        @unique
  userId       String
  roomTypeId   String
  adults       Int
  infants      Int           @default(0) // age 0–3
  child46      Int           @default(0) // age 4–6
  child711     Int           @default(0) // age 7–11
  needsBed     Boolean       @default(false) // derived, stored for hotel export
  needsCot     Boolean       @default(false) // derived, stored for hotel export
  totalAmount  Int                           // pence
  paidAmount   Int           @default(0)     // pence
  status       BookingStatus @default(DEPOSIT_ONLY)
  plan         PaymentPlan
  discountCode String?
  discountAmt  Int           @default(0)     // pence — from discount code
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user                User                 @relation(fields: [userId], references: [id])
  roomType            RoomType             @relation(fields: [roomTypeId], references: [id])
  occupants           Occupant[]
  payments            Payment[]
  instalmentSchedules InstalmentSchedule[]
  auditLogs           AuditLog[]

  @@map("bookings")
}

model Occupant {
  id        String   @id @default(cuid())
  bookingId String
  name      String
  dob       DateTime // full DOB — never age ranges
  gender    String   // M / F
  role      String   // Lead / Adult / Infant / Child46 / Child711
  createdAt DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("occupants")
}

// ─── Payments ────────────────────────────────────────────────────────────────

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORISED
  CAPTURED
  SETTLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  amount                Int           // pence
  refundedAmount        Int           @default(0)
  currency              String        @default("gbp")
  status                PaymentStatus @default(CREATED)
  idempotencyKey        String        @unique
  description           String?
  failureReason         String?
  isOffPlatform         Boolean       @default(false)
  offPlatformRef        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  booking   Booking    @relation(fields: [bookingId], references: [id])
  auditLogs AuditLog[]

  @@map("payments")
}

model InstalmentSchedule {
  id             String    @id @default(cuid())
  bookingId      String
  number         Int
  label          String
  amount         Int       // pence
  dueDate        DateTime
  status         String    @default("scheduled") // scheduled / paid / failed / cancelled
  paidAt         DateTime?
  idempotencyKey String    @unique               // booking_ref + instalment_number
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("instalment_schedules")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  bookingId     String?
  paymentId     String?
  action        String
  actor         String
  previousState Json?
  newState      Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  booking   Booking?  @relation(fields: [bookingId], references: [id])
  payment   Payment?  @relation(fields: [paymentId], references: [id])

  @@map("audit_log")
}

// ─── Room Types ──────────────────────────────────────────────────────────────

enum RoomCategory {
  SUPERIOR
  FAMILY
  SUITE
}

enum RoomView {
  SEA
  FOREST
  ACCESSIBLE
}

model RoomType {
  id             String       @id // e.g. superior_sea, family_forest
  displayName    String
  category       RoomCategory
  view           RoomView
  description    String?
  totalInventory Int
  roomsBooked    Int          @default(0) // incremented atomically on booking
  maxAdults      Int
  maxTotalPeople Int
  addBedAllowed  Boolean      @default(false)
  addCotAllowed  Boolean      @default(false)
  bothAllowed    Boolean      @default(false)
  isSeaview      Boolean      @default(false)
  isBundle       Boolean      @default(false)
  bookableOnline Boolean      @default(true)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bookings       Booking[]

  @@map("room_types")
}

// ─── Pricing Config ──────────────────────────────────────────────────────────
// Single active row. Admin edits via UI. All amounts in pence.
// NOTE: Rates below are 2026 placeholders — update when 2027 rates confirmed.

model PricingConfig {
  id                       String   @id @default(cuid())
  nights                   Int      @default(4)

  // Standard room rates (pence per night)
  rateAdultDoublePerNight  Int      // £128.75 = 12875
  rateAdultSinglePerNight  Int      // £257.50 = 25750  (1 adult pays double)
  rateInfantPerNight       Int      // £10.00  = 1000
  rateChild46First         Int      // £40.00  = 4000   (total for stay, first child)
  rateChild46Extra         Int      // £220.00 = 22000  (total for stay, each additional)
  rateChild711PerNight     Int      // £55.00  = 5500

  // Sea view supplement (flat, applied once)
  seaviewSupplement        Int      // £50.00  = 5000

  // Bundle room rates (pence per night — lower than standard)
  bundleRateAdultDouble    Int      // £118.75 = 11875
  bundleRateChild711Night  Int      // £50.00  = 5000
  bundleRateChild46Extra   Int      // £200.00 = 20000

  // Bundle discount — always applied on top of bundle rates
  bundleDiscountPercent    Int      @default(20)

  isActive                 Boolean  @default(true)
  updatedAt                DateTime @updatedAt
  updatedBy                String?

  @@map("pricing_config")
}

// ─── Discount Codes ──────────────────────────────────────────────────────────

model DiscountCode {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  discountPercent Int?
  discountFixed   Int?      // pence — fixed amount off
  isActive        Boolean   @default(true)
  usageCount      Int       @default(0)
  maxUsage        Int?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@map("discount_codes")
}

// ─── Stripe / Webhooks ───────────────────────────────────────────────────────

model ProcessedWebhook {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  processedAt   DateTime @default(now())

  @@map("processed_webhooks")
}
